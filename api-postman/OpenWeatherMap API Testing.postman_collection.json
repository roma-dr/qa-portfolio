  "item": [
    {
      "name": "Positive — Current Weather",
      "item": [
        {
          "name": "1.1 Weather by city name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response has main.temp\", function () {\n    const json = pm.response.json();\n    pm.expect(json.main).to.have.property(\"temp\");\n});\n\npm.test(\"Response has weather array\", function () {\n    const json = pm.response.json();\n    pm.expect(json.weather).to.be.an(\"array\").that.is.not.empty;\n});\n\npm.test(\"City name is present\", function () {\n    const json = pm.response.json();\n    pm.expect(json.name).to.be.a(\"string\");\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/weather?q={{city}}&appid={{api_key}}&units=metric",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "weather"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{city}}"
                },
                {
                  "key": "appid",
                  "value": "{{api_key}}"
                },
                {
                  "key": "units",
                  "value": "metric"
                }
              ]
            }
          },
          "response": []
        },
        {
