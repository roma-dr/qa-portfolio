          "name": "Pagination (limit + skip)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Exactly 5 products returned\", function () {\n    let jsonData = pm.response.json();\n    pm.expect(jsonData.products).to.be.an(\"array\");\n    pm.expect(jsonData.products.length).to.eql(5);\n    pm.expect(jsonData.limit).to.eql(5);\n    pm.expect(jsonData.skip).to.eql(10);\n    console.log(\"Returned:\", jsonData.products.length, \"| skip:\", jsonData.skip);\n});"
                ]
              }
            }
          ],
